{
  "name": "itsthanh-v4",
  "version": "4.0.1",
  "private": true,
  "description": "Shared front-end for the V4 redesign of itsthanh.me (Home, Project, Archive) on Webflow.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "fixtures": "node scripts/make-fixtures.cjs",
    "images": "node scripts/make-fixture-images.cjs",
    "sri": "node scripts/sri.cjs",
    "serve": "node scripts/serve.cjs",
    "test": "node --test --test-reporter=spec --test-concurrency=1 \"tests/*.test.*\""
  },
  "dependencies": {
    "@barba/core": "2.10.3",
    "gsap": "3.13.0",
    "lenis": "1.3.26"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
